# Copiez ce fichier en .env.local (et en .env pour les commandes Prisma), puis remplissez.

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL : connexion « Transaction pooler » (port 6543), utilisée par l'application
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL : connexion directe (port 5432), utilisée par les migrations Prisma
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Clé secrète des sessions : 32 caractères minimum. Générez-la avec : openssl rand -base64 32
SESSION_SECRET=""

# Adresse publique de l'application (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Étapes suivantes (paiements, emails) — à remplir plus tard
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
RESEND_API_KEY=""
