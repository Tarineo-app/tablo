# Copiez ce fichier en .env.local (et en .env pour les commandes Prisma), puis remplissez.

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL : connexion « Transaction pooler » (port 6543), utilisée par l'application
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL : connexion directe (port 5432), utilisée par les migrations Prisma
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Clé secrète des sessions : 32 caractères minimum. Générez-la avec : openssl rand -base64 32
SESSION_SECRET=""

# Adresse publique de l'application (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Connexion avec Google (facultatif : sans ces clés, le bouton Google n'apparaît pas)
# Google Cloud > APIs & Services > Credentials > OAuth client ID (type « Web application »)
# URI de redirection autorisée : http://localhost:3000/auth/google/callback (et celle de votre domaine en ligne)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Envoi des invitations par email (facultatif : sans clé, le lien est affiché à copier)
EMAIL_FROM="Tablo <onboarding@resend.dev>"

# Démonstration : met "1" pour ouvrir /demo-club, l'entrée dans l'espace club sans compte.
# Laisse vide pour la désactiver. L'établissement doit porter isDemo = true (c'est le cas du club seedé).
DEMO_LOGIN=""

# ── Paiements (Stripe) ─────────────────────────────────────────────
# Sans ces clés, le site marche : les réservations restent « à payer ».
# Stripe > Développeurs > Clés API (commencez en mode test : sk_test_…)
STRIPE_SECRET_KEY=""
# Stripe > Développeurs > Webhooks : DEUX points d'écoute vers https://VOTRE-SITE/api/stripe/webhook
#  1. « Votre compte » (abonnements Tablo) : checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=""
#  2. « Comptes connectés » (paiements des clubs) : checkout.session.completed, checkout.session.expired,
#     checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, account.updated
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Facultatif : un prix mensuel créé dans Stripe. Sans lui, l'abonnement Club est créé à 200 €/mois.
STRIPE_PRICE_CLUB=""

# ── Emails (Resend) ────────────────────────────────────────────────
# Resend > API Keys. Pour écrire depuis votre domaine, vérifiez-le dans Resend puis changez EMAIL_FROM.
RESEND_API_KEY=""
# Adresse pour la formule « Sur mesure » (bouton « Nous écrire »)
CONTACT_EMAIL=""

# ── Relances du matin (Vercel Cron) ────────────────────────────────
# Une longue phrase secrète. Vercel l'envoie automatiquement à /api/cron/daily chaque matin.
CRON_SECRET=""

# ── Photos (Supabase Storage) ──────────────────────────────────────
# Supabase > Project Settings > API : Project URL et clé « service_role » (secrète, jamais côté navigateur).
# Le bucket privé « tablo » est créé tout seul au premier envoi.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Lecture automatique du plan de salle par l'IA (configuration, étape « Carrés »). Sans clé : le plan est gardé en fond, carrés placés à la main.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
