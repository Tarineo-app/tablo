// Tablo — schéma de départ du MVP. Montants en centimes (Int).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  DIRECTOR
  MANAGER
  SERVER
  BARMAN
}

enum PayMode {
  FULL
  POOL // cagnotte
  CASH
}

enum ReservationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  FULLY_PAID
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  PAYMENT_ISSUE
}

enum OrderStatus {
  NEW
  TAKEN
  SERVED
  CANCELLED
}

enum TicketStatus {
  PENDING // en attente de paiement
  PAID
  CHECKED_IN // entré dans le club
  TRANSFERRED // donné à quelqu'un d'autre : remplacé par un nouveau billet
  RETURNED // repris par le club, la place est remise en vente
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Venue {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  city               String?
  kind               String    @default("club") // club | beach
  logoUrl            String?
  theme              Json? // { color, background, font, buttonRadius }
  rules              String? // âge minimum, tenue…
  cancelPolicy       String?
  planImageUrl       String?
  payModes           PayMode[] @default([FULL, CASH])
  poolDeadlineHour   Int       @default(18) // la veille, heure locale
  stripeAccountId    String? // Stripe Connect Express
  stripeCustomerId   String? // abonnement Tablo
  plan               String? // CLUB | PRESTIGE
  /// Garage : les bouteilles non terminées sont gardées au club pour la prochaine fois.
  garageEnabled      Boolean   @default(false)
  garageMinBottles   Int       @default(1) // bouteilles à racheter pour venir la rechercher
  garageDays         Int       @default(60) // durée de conservation
  garageKeepsMin     Boolean   @default(false) // true = le minimum du carré s'applique quand même
  /// Billetterie : fermée par défaut. Le cœur du produit, c'est le carré,
  /// et l'entrée simple est déjà bien servie ailleurs.
  ticketsEnabled     Boolean   @default(false)
  /// Revente des billets : transfert à un proche, et reprise par le club.
  ticketTransfer     Boolean   @default(true)
  ticketBuyback      Boolean   @default(false)
  ticketBuybackHours Int       @default(24) // jusqu'à X heures avant la soirée
  ticketBuybackPct   Int       @default(100) // part remboursée
  websiteUrl         String? // le site du club, où l'extension est posée
  /// Établissement de démonstration : visible sans compte, données fictives.
  isDemo             Boolean   @default(false)
  /// Facturation : on ouvre tout gratuitement, le club choisit une soirée d'essai,
  /// et le paiement n'est demandé qu'après cette nuit-là.
  billing            Billing   @default(SETUP)
  trialEventId       String? // la soirée offerte, choisie par le club
  trialPickedAt      DateTime?
  trialClosedAt      DateTime? // lendemain de la soirée d'essai : le bilan est prêt
  /// Vue 3D du plan : générée depuis le plan 2D, ou vraie visite si le club en a une.
  plan3d             Boolean   @default(true)
  planTilt           Int       @default(52) // inclinaison de départ, en degrés
  wallColor          String? // couleur du sol et des murs dans la vue 3D
  tour3dUrl          String? // visite 3D existante (Matterport, Polycam, modèle .glb)
  createdAt          DateTime  @default(now())

  memberships  Membership[]
  categories   TableCategory[]
  tables       VenueTable[]
  bottles      Bottle[]
  shows        Show[]
  events       Event[]
  reservations Reservation[]
  tickets      Ticket[]
  orders       Order[]
  offers       Offer[]
  garageItems  GarageItem[]
}

model Membership {
  id            String   @id @default(cuid())
  userId        String
  venueId       String
  role          Role
  managerCode   String?  @unique // lien perso du manager commercial
  commissionPct Int? // fixé par le directeur
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations Reservation[] @relation("ManagerReservations")
  ordersTaken  Order[]       @relation("ServerOrders")
  offers       Offer[]       @relation("ManagerOffers")
  tickets      Ticket[]      @relation("ManagerTickets")

  @@unique([userId, venueId])
}

model TableCategory {
  id            String       @id @default(cuid())
  venueId       String
  name          String // Prestige, Scène, Lounge…
  /// Rendu 3D : couleur du carré et hauteur de l'estrade (0 = à plat).
  color         String?
  elevation     Int          @default(2)
  depositPct    Int          @default(0) // 0 à 100
  includedShows Int          @default(0)
  minSpendCents Int          @default(0)
  sortOrder     Int          @default(0)
  venue         Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables        VenueTable[]
  eligibleShows Show[]       @relation("CategoryShows")
}

model VenueTable {
  id            String            @id @default(cuid())
  venueId       String
  categoryId    String
  name          String // « Impérial », « S1 »
  capacity      Int
  minSpendCents Int? // surcharge la catégorie
  photoUrl      String?
  // position sur le plan 2D, en % de l'image (0 à 100)
  x             Float
  y             Float
  w             Float
  h             Float
  active        Boolean           @default(true)
  venue         Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category      TableCategory     @relation(fields: [categoryId], references: [id])
  eventPrices   EventTablePrice[]
  reservations  Reservation[]
  offers        Offer[]
}

model Event {
  id           String            @id @default(cuid())
  venueId      String
  date         DateTime // date de la soirée (Europe/Paris)
  name         String?
  isOpen       Boolean           @default(true)
  venue        Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  prices       EventTablePrice[]
  reservations Reservation[]
  ticketTiers  TicketTier[]
  tickets      Ticket[]
  offers       Offer[]

  @@unique([venueId, date])
}

model EventTablePrice {
  id            String     @id @default(cuid())
  eventId       String
  tableId       String
  minSpendCents Int
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  table         VenueTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([eventId, tableId])
}

model Bottle {
  id       String       @id @default(cuid())
  venueId  String
  name     String
  type     String? // champagne, vodka…
  flavors  String[] // goûts éventuels
  photoUrl String?
  active   Boolean      @default(true)
  venue    Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sizes    BottleSize[]
  shows    Show[]
}

model BottleSize {
  id          String       @id @default(cuid())
  bottleId    String
  label       String // Classique, Magnum, Jéroboam…
  volume      String // 75 cl, 1,5 L
  priceCents  Int
  stock       Int? // null = illimité
  bottle      Bottle       @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  offerItems  OfferItem[]
  garageItems GarageItem[]
}

model Show {
  id               String            @id @default(cuid())
  venueId          String
  name             String
  description      String?
  priceCents       Int
  mediaUrl         String? // photo ou vidéo d'aperçu
  isSign           Boolean           @default(false) // la pancarte du club
  active           Boolean           @default(true)
  /// Option liée aux bouteilles : « couronne de 3 Moët ». Proposée à l'étape des bouteilles,
  /// débloquée quand le client a commandé assez de bouteilles. 0 = show classique.
  minBottles       Int               @default(0)
  /// Bouteille exigée pour cette option. null = n'importe quelle bouteille.
  bottleId         String?
  bottle           Bottle?           @relation(fields: [bottleId], references: [id], onDelete: SetNull)
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categories       TableCategory[]   @relation("CategoryShows")
  reservationShows ReservationShow[]
  offerItems       OfferItem[]
  orderItems       OrderItem[]
}

model Reservation {
  id                    String            @id @default(cuid())
  venueId               String
  eventId               String
  tableId               String
  managerId             String? // Membership du manager commercial
  status                ReservationStatus @default(DRAFT)
  payMode               PayMode
  guests                Int
  organizerName         String
  organizerEmail        String
  organizerPhone        String
  signText              String?
  totalCents            Int               @default(0)
  depositCents          Int               @default(0)
  paidCents             Int               @default(0)
  poolToken             String?           @unique // lien de cagnotte /c/[token]
  poolDeadline          DateTime?
  stripeCustomerId      String? // client Stripe de l'organisateur (sur le compte connecté)
  stripePaymentMethodId String? // carte enregistrée en garantie
  qrToken               String            @unique @default(cuid())
  garageItemId          String? // bouteille du garage récupérée ce soir-là
  createdAt             DateTime          @default(now())

  venue         Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event         Event             @relation(fields: [eventId], references: [id])
  table         VenueTable        @relation(fields: [tableId], references: [id])
  manager       Membership?       @relation("ManagerReservations", fields: [managerId], references: [id])
  garageItem    GarageItem?       @relation(fields: [garageItemId], references: [id])
  shows         ReservationShow[]
  orders        Order[]
  contributions Contribution[]
  offer         Offer?

  @@index([venueId, eventId])
}

model ReservationShow {
  id            String      @id @default(cuid())
  reservationId String
  showId        String
  included      Boolean     @default(false)
  priceCents    Int // 0 si inclus
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  show          Show        @relation(fields: [showId], references: [id])
}

model Contribution {
  id                    String        @id @default(cuid())
  reservationId         String
  name                  String
  email                 String?
  amountCents           Int
  isOrganizer           Boolean       @default(false)
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  reservation           Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// Envoi n°1, n°2, n°3… pendant la soirée
model Order {
  id            String      @id @default(cuid())
  venueId       String
  reservationId String
  number        Int
  status        OrderStatus @default(NEW)
  cashDueCents  Int         @default(0) // espèces à encaisser à table
  takenById     String?
  createdAt     DateTime    @default(now())
  servedAt      DateTime?
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  takenBy       Membership? @relation("ServerOrders", fields: [takenById], references: [id])
  items         OrderItem[]

  @@unique([reservationId, number])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  /// Un envoi porte des bouteilles, et depuis la recommande en soirée, des shows.
  bottleSizeId String?
  showId       String?
  flavor       String?
  quantity     Int
  unitCents    Int
  /// Bouteille rendue au client, pas vendue ce soir (elle était au garage).
  fromGarage   Boolean     @default(false)
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bottleSize   BottleSize? @relation(fields: [bottleSizeId], references: [id])
  show         Show?       @relation(fields: [showId], references: [id])
}

/// Billetterie : un tarif d'entrée pour une soirée (ex. « Avant minuit + 1 conso »).
model TicketTier {
  id         String   @id @default(cuid())
  eventId    String
  name       String
  priceCents Int
  drinks     Int      @default(0) // consommations incluses
  untilTime  String? // "00:30" = arrivée avant cette heure ; null = toute la nuit
  quota      Int? // places maximum ; null = sans limite
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
}

/// Achat d'entrées : une commande, un QR code, N personnes.
model Ticket {
  id           String       @id @default(cuid())
  venueId      String
  eventId      String
  tierId       String
  managerId    String?
  status       TicketStatus @default(PENDING)
  quantity     Int
  totalCents   Int
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  qrToken      String       @unique
  checkedIn    Int          @default(0) // personnes déjà entrées
  checkedInAt  DateTime?
  /// Billet d'origine, quand celui-ci vient d'un transfert.
  fromTicketId String?
  returnedAt   DateTime?
  refundCents  Int          @default(0) // à rembourser par le club quand il reprend le billet
  createdAt    DateTime     @default(now())

  venue   Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event   Event       @relation(fields: [eventId], references: [id])
  tier    TicketTier  @relation(fields: [tierId], references: [id])
  manager Membership? @relation("ManagerTickets", fields: [managerId], references: [id])
  from    Ticket?     @relation("TicketTransfer", fields: [fromTicketId], references: [id])
  to      Ticket[]    @relation("TicketTransfer")

  @@index([venueId, eventId])
}

enum Billing {
  SETUP // il construit son espace, rien n'est ouvert au public
  TRIAL // sa soirée d'essai est choisie : tout fonctionne cette nuit-là
  ACTIVE // abonné
  LOCKED // l'essai est passé, il faut payer pour rouvrir
}

enum GarageStatus {
  STORED // gardée au club
  RETRIEVED // reprise par le client
  EXPIRED // délai dépassé
}

/// Une bouteille entamée ou non ouverte, gardée au club pour la prochaine venue du client.
/// Le code est donné au client : c'est lui qui le saisit dans le widget pour revenir la chercher.
model GarageItem {
  id           String       @id @default(cuid())
  venueId      String
  code         String       @unique
  ownerName    String
  ownerEmail   String
  ownerPhone   String
  bottleSizeId String
  quantity     Int          @default(1)
  flavor       String?
  note         String? // « entamée aux trois quarts », « bouchon marqué 14 »
  status       GarageStatus @default(STORED)
  expiresAt    DateTime
  retrievedAt  DateTime?
  createdAt    DateTime     @default(now())

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bottleSize   BottleSize    @relation(fields: [bottleSizeId], references: [id])
  reservations Reservation[]

  @@index([venueId, status])
}

enum OfferStatus {
  REQUESTED // le client a demandé une offre, le manager doit la chiffrer
  SENT // le manager a envoyé son prix
  ACCEPTED // le client a dit oui : la réservation est créée
  DECLINED
  EXPIRED
  CANCELLED
}

/// Une offre d'un manager commercial : il compose la soirée d'un client
/// (carré, bouteilles, shows, pancarte), fixe SON prix, et envoie un lien.
/// Dans l'autre sens, le client demande une offre et le manager la chiffre.
model Offer {
  id            String      @id @default(cuid())
  venueId       String
  eventId       String
  managerId     String? // Membership du manager commercial
  tableId       String?
  status        OfferStatus @default(SENT)
  code          String      @unique // lien public /o/[code]
  guests        Int         @default(4)
  clientName    String?
  clientEmail   String?
  clientPhone   String?
  /// Le mot du manager au client, et ce que le client avait demandé.
  message       String?
  askNote       String?
  signText      String?
  /// Le prix annoncé par le manager, tout compris. `listCents` est la valeur
  /// au tarif public : l'écart entre les deux est ce que le manager offre.
  priceCents    Int         @default(0)
  listCents     Int         @default(0)
  expiresAt     DateTime?
  reservationId String?     @unique
  createdAt     DateTime    @default(now())
  sentAt        DateTime?
  decidedAt     DateTime?

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  manager     Membership?  @relation("ManagerOffers", fields: [managerId], references: [id])
  table       VenueTable?  @relation(fields: [tableId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  items       OfferItem[]

  @@index([venueId, eventId])
  @@index([venueId, status])
}

model OfferItem {
  id           String      @id @default(cuid())
  offerId      String
  bottleSizeId String?
  showId       String?
  flavor       String?
  quantity     Int         @default(1)
  /// Prix public de référence. `offered` = le manager l'ajoute sans le facturer.
  unitCents    Int         @default(0)
  offered      Boolean     @default(false)
  sortOrder    Int         @default(0)
  offer        Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  bottleSize   BottleSize? @relation(fields: [bottleSizeId], references: [id])
  show         Show?       @relation(fields: [showId], references: [id])
}
